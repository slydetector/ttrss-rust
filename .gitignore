# Build artifacts
target/
*.rs.bk

# Oracle generated data (dumps, fixtures, logs)
oracle/data/
oracle/corpus/scenarios.toml

# Local env / secrets (oracle/.env is non-sensitive and committed on purpose)
.env
!oracle/.env
*.log
.pytest_cache/
__pycache__/
.venv/

# The PHP reference (tt-rss/) is a git submodule (see .gitmodules;
# `make bootstrap` after a fresh clone). The Android client checkout
# stays a local-only clone.
/tt-rss-android/

# Local agent state + browser-probe output (transient, regenerated)
.pi/
browser/out/

# Shadow-prod host data dirs (prod DB copy + feed icons; host-mounted, inspectable)
shadow/data/

# Local dev-server data dir (media cache etc.; transient)
/data/

# e2e (Playwright): deps, captured star-banner password, reports
e2e/node_modules/
e2e/.admin-pass
e2e/test-results/
e2e/playwright-report/
e2e/out/
# e2e throwaway artifacts (synthesized by setup, removed by teardown)
e2e/compose.yaml
e2e/.env

*.swp
*.swo

