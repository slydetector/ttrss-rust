# Oracle stack configuration. All values are non-sensitive local dev defaults;
# this file is committed on purpose.

# Web (nginx) port on the host.
HTTP_PORT=8280

# Database (matches the upstream docker defaults).
TTRSS_DB_USER=postgres
TTRSS_DB_NAME=postgres
TTRSS_DB_PASS=password

# Built-in admin user (applied on every startup).
ADMIN_USER_PASS=admin

# One extra user auto-created unless it already exists (readonly).
AUTO_CREATE_USER=readonly
AUTO_CREATE_USER_PASS=readonlypass
AUTO_CREATE_USER_ACCESS_LEVEL=-1

# Plugins loaded system-wide.
#   af_psql_trgm: full-text search (pg_trgm)
#   nginx_xaccel: served from the image's plugins.local
TTRSS_PLUGINS=auth_internal,af_psql_trgm,af_youtube_embed,auto_assign_labels,bookmarklets,note,nsfw,share,nginx_xaccel

# Enable xchacha20poly1305-ietf session encryption (hex-encoded 32-byte key).
TTRSS_ENCRYPTION_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08

# Feed update daemon poll interval (seconds).
TTRSS_DAEMON_SLEEP_INTERVAL=60
