# shadow/.env — shadow-prod configuration.
# Copy this to shadow/.env (which is gitignored) and fill in the PROD_* values.
# Only PROD_DB_* are required; the remaining lines (TTRSS_*, RUST_LOG,
# host ports, EXPECTED_SCHEMA_VERSION) have defaults (shadow/shadow.sh +
# compose.yaml) and can stay commented.

# --- production database (REQUIRED: the tt-rss DB to copy) ---
PROD_DB_HOST=your-prod-db-host
PROD_DB_PORT=5432
PROD_DB_USER=ttrss
PROD_DB_NAME=ttrss
PROD_DB_PASS=change-me

# --- shadow (local) settings (defaults shown; override only if needed) ---
# Host port the shadow web server listens on (demo is 8281, so 8282 coexists).
#SHADOW_PORT=8282
# Host port the shadow Postgres is exposed on (for direct psql poking).
#SHADOW_DB_PORT=5433
# Local shadow DB credentials / name (the prod copy is loaded into this DB).
#TTRSS_DB_USER=shadow
#TTRSS_DB_PASS=shadow
#TTRSS_DB_NAME=shadow
# The self URL the app is served under (the address you'll open in a browser).
#TTRSS_SELF_URL_PATH=http://127.0.0.1:8282/tt-rss/
# RUST_LOG (tracing filter) for the Rust server. Defaults to `info` (no feed-
# update debug output). Set to `debug` (or `ttrss=debug`) to see the daemon's
# feed-update logs ("daemon: updating due feeds", "feed update ok", "stored
# article seems up to date", …) via `docker compose logs rust`.
#RUST_LOG=debug
# TTRSS_ENCRYPTION_KEY — MUST be a valid hex key (even length) or the server
# won't start. Defaults to the oracle key so it runs out of the box; set it to
# prod's key only if your prod has authenticated feeds (this one doesn't).
#TTRSS_ENCRYPTION_KEY=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
# The tt-rss schema version the port targets (frozen reference sha-2f7d831).
# The preflight hard-fails unless prod's ttrss_version.schema_version equals this.
#EXPECTED_SCHEMA_VERSION=151
