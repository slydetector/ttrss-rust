# Build context is the repo root. The image build only needs the workspace
# (Cargo.* + crates/) and the tt-rss frontend docroot — exclude everything else.
target/
oracle/
docs/
tt-rss-android/
.git/
.pi/
.ruff_cache/
.config/
browser/
.pi-lens.json
demo.log
demo.pid
AGENTS.md
README.md
Makefile
.github/
# e2e/: host-side Playwright suite (the image is tested by it, not built
# from it) — node_modules + test artifacts would bloat every build context.
e2e/
# shadow/: local prod-copy data (a full production DB dump) + secrets.
shadow/data
shadow/.env
data
.venv
*.log
.env
