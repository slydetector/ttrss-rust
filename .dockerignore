# Build context is the repo root. The image build only needs the workspace
# (Cargo.* + crates/) and the tt-rss frontend docroot — exclude everything else.
target/
oracle/
docs/
tt-rss-android/
.git/
.pi/
.ruff_cache/
.config/
browser/
.pi-lens.json
demo.log
demo.pid
AGENTS.md
README.md
Makefile
.github/
# e2e/: host-side Playwright suite (the image is tested by it, not built
# from it) — the heavy dirs out of every build context; the small sources
# stay because ci/Dockerfile (the CI job image) bakes the package files.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/compose.yaml
e2e/.env
e2e/.admin-pass
# shadow/: local prod-copy data (a full production DB dump) + secrets.
shadow/data
shadow/.env
data
.venv
*.log
.env
