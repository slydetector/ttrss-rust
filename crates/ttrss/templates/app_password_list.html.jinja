<div dojoType='fox.Toolbar'>
	<div dojoType='fox.form.DropDownButton'>
		<span>{{ t_select }}</span>
		<div dojoType='dijit.Menu' style='display: none'>
			<div onclick="Tables.select('app-password-list', true)"
				dojoType="dijit.MenuItem">{{ t_all }}</div>
			<div onclick="Tables.select('app-password-list', false)"
				dojoType="dijit.MenuItem">{{ t_none }}</div>
		</div>
	</div>
</div>

<div class='panel panel-scrollable'>
	<table width='100%' id='app-password-list'>
		<tr>
			<th class="checkbox"> </th>
			<th width='50%'>{{ t_description }}</th>
			<th>{{ t_created }}</th>
			<th>{{ t_last_used }}</th>
		</tr>
		{% for pass in passwords %}
		<tr data-row-id='{{ pass.id }}'>
			<td class="checkbox">
				<input onclick='Tables.onRowChecked(this)' dojoType='dijit.form.CheckBox' type='checkbox'>
			</td>
			<td>
				{{ pass.title }}
			</td>
			<td class='text-muted'>
				{{ pass.created }}
			</td>
			<td class='text-muted'>
				{{ pass.last_used }}
			</td>
		</tr>
		{% endfor %}
	</table>
</div>
