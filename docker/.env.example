# tt-rss (Rust) — blessed stack configuration.
# Copy to .env (same directory) and edit. Values are passed to the app
# container verbatim (env_file) and interpolate the compose file (${...}).

# Port to expose on the host (host:port, or bare port for all interfaces).
# To run behind a reverse proxy on the same host: HTTP_PORT=127.0.0.1:9000
# Must be defined — compose has no fallback for it.
HTTP_PORT=9000

# Database credentials. Consumed by the db service (mapped to POSTGRES_*)
# and by the app. Change these.
TTRSS_DB_NAME=postgres
TTRSS_DB_USER=postgres
TTRSS_DB_PASS=password

# --- optional (image defaults in parentheses) ---
# Full base URL of the app, for generated links/opml. (unset: relative)
# TTRSS_SELF_URL_PATH=https://feeds.example.com

# System-enabled plugins. (auth_internal,tweak_article_header)
# TTRSS_PLUGINS=auth_internal

# Log level: error, warn, info, debug, trace. (info)
# RUST_LOG=info
